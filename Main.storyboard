                                <fontDescription key="fontDescription" type="system" pointSize="16"/>
                                <color key="textColor" systemColor="secondaryLabelColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="LOST ITEMS" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="lost-caption">
                                <rect key="frame" x="30" y="328" width="78" height="15.666666666666686"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="13"/>
                                <color key="textColor" systemColor="secondaryLabelColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="0" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="lost-count">
                                <rect key="frame" x="30" y="347.66666666666669" width="78" height="38.333333333333314"/>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="32"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="FOUND ITEMS" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="found-caption">
                                <rect key="frame" x="272.66666666666669" y="328" width="90.333333333333314" height="15.666666666666686"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="13"/>
                                <color key="textColor" systemColor="secondaryLabelColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="0" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="found-count">
                                <rect key="frame" x="272.66666666666669" y="347.66666666666669" width="90.333333333333314" height="38.333333333333314"/>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="32"/>
                            </label>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="view-reports">
                                <rect key="frame" x="24" y="436" width="345" height="54"/>
                                <color key="backgroundColor" systemColor="systemBlueColor"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="54" id="reports-height"/>
                                </constraints>
                                <state key="normal" title="View All Reports">
                                    <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                </state>
                                <connections>
                                    <action selector="viewReportsTapped:" destination="home-vc" eventType="touchUpInside" id="reports-action"/>
                                </connections>
                            </button>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="report-item">
                                <rect key="frame" x="24" y="504" width="345" height="54"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="54" id="report-height"/>
                                </constraints>
                                <state key="normal" title="＋  Report an Item"/>
                                <connections>
                                    <action selector="reportItemTapped:" destination="home-vc" eventType="touchUpInside" id="report-action"/>
                                </connections>
                            </button>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="home-safe"/>
                        <color key="backgroundColor" systemColor="systemGroupedBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="home-title" firstAttribute="top" secondItem="home-safe" secondAttribute="top" constant="40" id="h1"/>
                            <constraint firstItem="found-caption" firstAttribute="trailing" secondItem="home-safe" secondAttribute="trailing" constant="-30" id="h10"/>
                            <constraint firstItem="lost-count" firstAttribute="top" secondItem="lost-caption" secondAttribute="bottom" constant="4" id="h11"/>
                            <constraint firstItem="lost-count" firstAttribute="leading" secondItem="lost-caption" secondAttribute="leading" id="h12"/>
                            <constraint firstItem="lost-count" firstAttribute="trailing" secondItem="lost-caption" secondAttribute="trailing" id="h13"/>
                            <constraint firstItem="found-count" firstAttribute="top" secondItem="found-caption" secondAttribute="bottom" constant="4" id="h14"/>
                            <constraint firstItem="found-count" firstAttribute="leading" secondItem="found-caption" secondAttribute="leading" id="h15"/>
                            <constraint firstItem="found-count" firstAttribute="trailing" secondItem="found-caption" secondAttribute="trailing" id="h16"/>
                            <constraint firstItem="view-reports" firstAttribute="top" secondItem="lost-count" secondAttribute="bottom" constant="50" id="h17"/>
                            <constraint firstItem="view-reports" firstAttribute="leading" secondItem="home-safe" secondAttribute="leading" constant="24" id="h18"/>
                            <constraint firstItem="view-reports" firstAttribute="trailing" secondItem="home-safe" secondAttribute="trailing" constant="-24" id="h19"/>
                            <constraint firstItem="home-title" firstAttribute="leading" secondItem="home-safe" secondAttribute="leading" constant="24" id="h2"/>
                            <constraint firstItem="report-item" firstAttribute="top" secondItem="view-reports" secondAttribute="bottom" constant="14" id="h20"/>
                            <constraint firstItem="report-item" firstAttribute="leading" secondItem="view-reports" secondAttribute="leading" id="h21"/>
                            <constraint firstItem="report-item" firstAttribute="trailing" secondItem="view-reports" secondAttribute="trailing" id="h22"/>
                            <constraint firstItem="home-title" firstAttribute="trailing" secondItem="home-safe" secondAttribute="trailing" constant="-24" id="h3"/>
