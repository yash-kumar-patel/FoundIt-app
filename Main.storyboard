                                        <constraint firstItem="cell-status" firstAttribute="top" secondItem="cell-detail" secondAttribute="bottom" constant="2" id="c7"/>
                                        <constraint firstItem="cell-status" firstAttribute="leading" secondItem="cell-title" secondAttribute="leading" id="c8"/>
                                        <constraint firstItem="cell-status" firstAttribute="bottom" secondItem="item-content" secondAttribute="bottom" constant="-6" id="c9"/>
                                    </constraints>
                                </tableViewCellContentView>
                                <connections>
                                    <outlet property="detailLabel" destination="cell-detail" id="cell-detail-outlet"/>
                                    <outlet property="itemTitleLabel" destination="cell-title" id="cell-title-outlet"/>
                                    <outlet property="statusLabel" destination="cell-status" id="cell-status-outlet"/>
                                </connections>
                            </tableViewCell>
